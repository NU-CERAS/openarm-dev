# Upstream OpenArm sources. Imported into src/vendor/ by post-create.sh.
# For a class, pin "version" to a release tag or commit so everyone builds the
# same thing (check the tags on each repo first), e.g. version: 1.0.3
repositories:
  openarm_description:
    type: git
    url: https://github.com/enactic/openarm_description.git
    version: main
  openarm_ros2:
    type: git
    url: https://github.com/enactic/openarm_ros2.git
    version: main
  # Needed only for real hardware (openarm_hardware). Uncomment when the arm arrives.
  # openarm_can:
  #   type: git
  #   url: https://github.com/enactic/openarm_can.git
  #   version: main
