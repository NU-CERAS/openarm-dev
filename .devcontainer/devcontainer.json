{
  "name": "OpenArm ROS 2 Jazzy",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/openarm-dev",
  "remoteUser": "ubuntu",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "postCreateCommand": "bash scripts/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
