{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run MuJoCo",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/sim.py"
      ],
      "osx": {
        "command": "/bin/bash",
        "args": [
          "-c",
          "exec \"$(dirname \"$1\")/mjpython\" \"$2\"",
          "openarm",
          "${command:python.interpreterPath}",
          "${workspaceFolder}/scripts/sim.py"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
